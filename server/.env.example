# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me

# Telegram user ids of super-admins, comma separated (find yours via @userinfobot)
ADMIN_IDS=111111111

# Local run (docker compose overrides these for the bot container)
# Required by docker compose; use a long random value in production
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://proactive:change-me@localhost:5432/proactive_bot
# REDIS_URL=redis://localhost:6379/0

TIMEZONE=Asia/Tashkent
# Language for new users before they pick one, and for the moderation chat: ru | uz | en
DEFAULT_LANG=ru

# Booking rules
HOLD_MINUTES=30
MAX_PROOF_ATTEMPTS=3
MAX_TICKETS_PER_ORDER=5
# Shave 1..99 sum off each amount so every transfer can be matched to its order
UNIQUE_AMOUNTS=true
# Remind admins about receipts waiting longer than this
REVIEW_ALERT_MINUTES=120

# Optional fallbacks; all can be set from the bot: /admin -> Card / Moderation chat / Requests chat
# PAYMENT_CARD_NUMBER=8600123412341234
# PAYMENT_CARD_HOLDER=PROACTIVE LLC
# PAYMENT_CARD_BANK=Kapitalbank
# MODERATION_CHAT_ID=-1001234567890
# LEADS_CHAT_ID=-1001234567891

# Bridge to the task-status spreadsheet (bot/Bridge.gs): staff commands /my, /team, /test go there.
# Leave both empty while you develop with a test bot. BRIDGE_SECRET comes from the spreadsheet menu
# "Бот -> Подключить сервер (aiogram)"; BRIDGE_URL is the web app address ending with /exec.
# BRIDGE_URL=https://script.google.com/macros/s/.../exec
# BRIDGE_SECRET=

# Staff tasks (docs/STAFF.md): the status spreadsheet id (between /d/ and /edit), shared with the
# service account of GOOGLE_SERVICE_ACCOUNT_FILE as an Editor. Empty: the Tasks section is off.
# STATUS_SHEET_ID=
# Roles from the «Команда» sheet that see the summary of every department, comma separated
# TASKS_SEE_ALL=Темур
# TASKS_POLL_SECONDS=60

# Google Sheets mirror (docs/GOOGLE_SHEETS.md). Key file goes to ./secrets/, the link can be set in the bot.
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# GOOGLE_SHEET_ID=
# SHEETS_SYNC_MINUTES=2

# Shown in /help and in refund messages, without @
# SUPPORT_USERNAME=proactive_support

# Font for ticket images if the default (DejaVu / Segoe UI / Arial) is missing
# TICKET_FONT_PATH=/path/to/font.ttf
